{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "recordType": {
      "const": "ALCH"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "gameDataVersion": {
            "$ref": "Common.schema.json#/$defs/GameDataVersion"
          },
          "sourcePlugin": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "script": {
            "type": [
              "string",
              "null"
            ]
          },
          "autoCalculate": {
            "type": "boolean"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "Common.schema.json#/$defs/Effect"
            }
          }
        },
        "required": [
          "id",
          "name",
          "gameDataVersion",
          "weight",
          "value",
          "autoCalculate",
          "effects"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "recordType",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Potions"
}
