{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "recordType": {
      "const": "CLOT"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "gameDataVersion": {
            "$ref": "Common.schema.json#/$defs/GameDataVersion"
          },
          "sourcePlugin": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "script": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "pants",
              "shoes",
              "shirt",
              "belt",
              "robe",
              "right_glove",
              "left_glove",
              "skirt",
              "ring",
              "amulet"
            ]
          },
          "enchantp": {
            "type": "number",
            "minimum": 0
          },
          "enchantment": {
            "anyOf": [
              {
                "$ref": "Common.schema.json#/$defs/Enchantment"
              },
              {
                "type": "null"
              }
            ]
          },
          "bodyParts": {
            "type": "array",
            "items": {
              "$ref": "Common.schema.json#/$defs/BodyPart"
            }
          }
        },
        "required": [
          "id",
          "name",
          "gameDataVersion",
          "weight",
          "value",
          "type",
          "enchantp",
          "enchantment",
          "bodyParts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "recordType",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clothing"
}
