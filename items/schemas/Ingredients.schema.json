{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "recordType": {
      "const": "INGR"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "gameDataVersion": {
            "$ref": "Common.schema.json#/$defs/GameDataVersion"
          },
          "sourcePlugin": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "script": {
            "type": [
              "string",
              "null"
            ]
          },
          "effects": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "effectId": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "skill": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "attribute": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "slot",
                "effectId",
                "name",
                "skill",
                "attribute"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "gameDataVersion",
          "weight",
          "value",
          "effects"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "recordType",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ingredients"
}
