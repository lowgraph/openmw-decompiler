    "Lightning Shield":      {"tier": "qol",       "cap": 30,  "fit": "all",     "source": "placed"},
    "Water Breathing":       {"tier": "qol",       "cap": 1,   "fit": "all",     "source": "placed"},
    "Resist Common Disease": {"tier": "low",       "cap": 100, "fit": "all",     "source": "placed"},
    "Resist Blight Disease": {"tier": "low",       "cap": 100, "fit": "all",     "source": "placed"},
