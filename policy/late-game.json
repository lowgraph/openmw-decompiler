  "derived": {
    "Fortify Skill": {"cap": 25, "major": 8, "minor": 5, "misc": 1,
                      "note": "Weighted by where the skill sits in the build: major, minor or neither."},
    "Fortify Attribute": {"cap": 25, "favoured": 8, "perGovernedSkill": 1.5, "floor": 2, "ceiling": 8, "luck": 3,
                          "note": "Favoured attributes weigh most. Otherwise the weight grows with how many of the build's major and minor skills the attribute governs. Luck governs nothing and gets a flat weight."}
  },
  "armour": {"major": 8, "minor": 5, "misc": 2, "ratingCap": 80,
             "note": "An armour piece adds its rating, weighted by the build's skill in that armour class. A full-cap Daedric piece on a major-skill build is worth one full-cap major Fortify Skill."},
  "weapons": {"major": 8, "minor": 5, "misc": 1, "damageCap": 60,
              "note": "A weapon adds its best damage, weighted by the build's skill in that weapon type."},
  "archetypes": {
    "caster": {"skills": ["alteration", "conjuration", "destruction", "illusion", "mysticism", "restoration"], "atLeast": 2,
               "note": "A build that casts: two or more casting schools among its major and minor skills. A Battlemage qualifies; a Pure melee build does not."},
    "fighter": {"skills": ["long_blade", "short_blade", "blunt_weapon", "axe", "spear", "marksman", "hand_to_hand"], "atLeast": 1}
  },
  "criticalAttributes": {
    "all": ["endurance"],
    "caster": ["intelligence", "willpower"],
    "fighter": ["strength", "agility"],
    "note": "The attributes an archetype actually runs on, which is not the same as the attributes that govern its skills. Both Conjurer builds carry Illusion, so Personality governs a skill of theirs, yet draining Personality does not stop them conjuring; draining Intelligence does. Only these escalate with magnitude."
  },
  "drawbacks": {
    "Drain Attribute":            {"rule": "attribute", "favoured": "disqualifying", "critical": "significant", "governing": "significant", "other": "minor", "zeroesAt": 100},
    "Damage Attribute":           {"rule": "attribute", "favoured": "disqualifying", "critical": "disqualifying", "governing": "significant", "other": "significant", "zeroesAt": 100},
    "Drain Skill":                {"rule": "skill", "major": "significant", "minor": "significant", "misc": "minor", "zeroesAt": 100},
    "Damage Skill":               {"rule": "skill", "major": "disqualifying", "minor": "significant", "misc": "minor", "zeroesAt": 100},
    "Drain Magicka":              {"rule": "archetype", "caster": "disqualifying", "other": "minor"},
    "Damage Magicka":             {"rule": "archetype", "caster": "disqualifying", "other": "minor"},
    "Silence":                    {"rule": "archetype", "caster": "disqualifying", "other": "minor"},
    "Sound":                      {"rule": "archetype", "caster": "significant", "other": "none"},
    "Drain Health":               {"rule": "flat", "severity": "disqualifying"},
    "Damage Health":              {"rule": "flat", "severity": "disqualifying"},
    "Fire Damage":                {"rule": "flat", "severity": "disqualifying"},
    "Frost Damage":               {"rule": "flat", "severity": "disqualifying"},
    "Shock Damage":               {"rule": "flat", "severity": "disqualifying"},
    "Drain Fatigue":              {"rule": "flat", "severity": "significant"},
    "Damage Fatigue":             {"rule": "flat", "severity": "significant"},
    "Blind":                      {"rule": "flat", "severity": "significant", "mitigation": "Resist Magicka",
                                   "note": "Boots of Blinding Speed carry Blind 100 and are still rated near-essential, because Resist Magicka cancels it."},
    "Weakness to Normal Weapons": {"rule": "flat", "severity": "significant"},
    "Weakness to Magicka":        {"rule": "flat", "severity": "significant"},
    "Weakness to Fire":           {"rule": "flat", "severity": "minor"},
    "Weakness to Frost":          {"rule": "flat", "severity": "minor"},
    "Weakness to Shock":          {"rule": "flat", "severity": "minor"},
    "Weakness to Poison":         {"rule": "flat", "severity": "minor"},
