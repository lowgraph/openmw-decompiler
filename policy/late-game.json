    "Detect Enchantment":    {"tier": "low",       "cap": 1,   "fit": "all",     "source": "placed"},
    "Detect Key":            {"tier": "low",       "cap": 1,   "fit": "all",     "source": "placed"},
    "Telekinesis":           {"tier": "low",       "cap": 1,   "fit": "all",     "source": "placed"},
    "Restore Attribute":     {"tier": "low",       "cap": 1,   "fit": "all",     "source": "placed"},
    "Bound Helm":            {"tier": "low",       "cap": 1,   "fit": "all",     "source": "placed"}
