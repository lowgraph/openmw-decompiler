{
  "schemaVersion": "1.0.0",
  "policyVersion": "2026.09.21",
  "name": "Silt Strider late-game loadout policy",
  "notes": [
    "Authored rules, versioned independently of any extraction snapshot.",
    "Candidates are items that already carry a constant effect. Enchantment capacity and custom enchanting are deliberately out of scope.",
    "Questing is always assumed for late game: an item a script hands to the player counts as obtainable even when nothing places it in the world.",
    "Every effect that appears on a candidate must be covered below, and every effect named below must appear on a candidate. The build refuses either gap, so an unmapped effect can never quietly score zero.",
    "source 'research' means the tier came from guide and forum sentiment the user approved on 2026-09-20. source 'placed' means it did not, and was placed by the data agent for the user to adjust."
  ],
  "tiers": {"essential": 10, "strong": 6, "qol": 3, "low": 1},
  "toggles": {
    "allowFormidableSources": {
      "default": false,
      "formidableLevel": 30,
      "note": "Off drops items whose easiest route means facing or robbing an actor above this level, unless a quest hands them over instead. The Royal Signet Ring is the case that prompted it: its only route is taking it off King Helseth, level 35. It is the fifth hardest of the forty best candidates, not the hardest."
    }
  },
  "effects": {
    "Restore Health":        {"tier": "essential", "cap": 5,   "fit": "all",     "source": "research"},
    "Resist Magicka":        {"tier": "essential", "cap": 100, "fit": "all",     "source": "research"},
    "Reflect":               {"tier": "essential", "cap": 100, "fit": "all",     "source": "research"},
    "Spell Absorption":      {"tier": "essential", "cap": 100, "fit": "all",     "source": "research"},
    "Restore Fatigue":       {"tier": "essential", "cap": 5,   "fit": "all",     "source": "research"},
    "Sanctuary":             {"tier": "strong",    "cap": 200, "fit": "all",     "source": "research"},
    "Chameleon":             {"tier": "strong",    "cap": 100, "fit": "all",     "source": "research"},
    "Resist Paralysis":      {"tier": "strong",    "cap": 100, "fit": "all",     "source": "research"},
    "Fortify Maximum Magicka": {"tier": "strong",  "cap": 20,  "fit": "caster",  "source": "research"},
    "Levitate":              {"tier": "qol",       "cap": 1,   "fit": "all",     "source": "research"},
    "Water Walking":         {"tier": "qol",       "cap": 1,   "fit": "all",     "source": "research",
                              "caveat": "Blocks going underwater, which some quests need."},
    "SlowFall":              {"tier": "qol",       "cap": 1,   "fit": "all",     "source": "research"},
    "Swift Swim":            {"tier": "qol",       "cap": 50,  "fit": "all",     "source": "research"},
    "Night Eye":             {"tier": "qol",       "cap": 1,   "fit": "all",     "source": "research"},
    "Feather":               {"tier": "low",       "cap": 100, "fit": "all",     "source": "research"},
    "Jump":                  {"tier": "low",       "cap": 50,  "fit": "all",     "source": "research"},
    "Detect Animal":         {"tier": "low",       "cap": 1,   "fit": "all",     "source": "research"},

    "Fortify Attack":        {"tier": "strong",    "cap": 25,  "fit": "fighter", "source": "placed"},
    "Fortify Health":        {"tier": "strong",    "cap": 50,  "fit": "all",     "source": "placed"},
    "Fortify Magicka":       {"tier": "strong",    "cap": 50,  "fit": "caster",  "source": "placed"},
